@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/eggs.stacktrace-targets.cmake")

foreach(_export IN ITEMS @EGGS_STACKTRACE_CHECKED_BACKENDS@)
    string(TOLOWER "${_export}" _backend)
    string(TOUPPER "${_export}" _upper)
    include("${CMAKE_CURRENT_LIST_DIR}/Check${_export}Backend.cmake")
    cmake_language(
        CALL eggs_stacktrace_check_${_backend}_backend
        EGGS_STACKTRACE_HAVE_${_upper}
    )
    if(EGGS_STACKTRACE_HAVE_${_upper})
        include(
            "${CMAKE_CURRENT_LIST_DIR}/eggs.stacktrace-${_backend}-targets.cmake"
        )
    else()
        message(
            WARNING
            "eggs.stacktrace: ${_backend} backend dependencies could not be resolved on this machine; the ${_export} backend will not be available"
        )
    endif()
endforeach()
unset(_export)
unset(_backend)
unset(_upper)

# Create the canonical Eggs::Stacktrace alias for the configured default backend.
if(NOT TARGET Eggs::Stacktrace)
    set(_eggs_stacktrace_default @EGGS_STACKTRACE_DEFAULT_BACKEND_EXPORT@)
    if(NOT TARGET Eggs::Stacktrace::${_eggs_stacktrace_default})
        message(WARNING "eggs.stacktrace: falling back to the Null backend")
        set(_eggs_stacktrace_default Null)
    endif()
    add_library(
        Eggs::Stacktrace
        ALIAS Eggs::Stacktrace::${_eggs_stacktrace_default}
    )
    unset(_eggs_stacktrace_default)
endif()

check_required_components(Eggs.Stacktrace)
