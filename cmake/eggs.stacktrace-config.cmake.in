@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/eggs.stacktrace-targets.cmake")

# The Execinfo backend, when built, is exported as its own targets file
# rather than being bundled into the one above: its dependency
# (backtrace(), dladdr(), and __cxa_demangle()) is resolved from the
# system C library / libdl on the machine that built this package, which
# may not be present (or not link successfully) on this one - so it must
# be re-checked here, same as any other environment-dependent transitive
# dependency. Isolating it in its own file means that, if the check
# fails, only this backend goes missing instead of failing to include the
# targets file above.
if(@EGGS_STACKTRACE_HAVE_EXECINFO@)
    include("${CMAKE_CURRENT_LIST_DIR}/CheckExecinfoBackend.cmake")
    eggs_stacktrace_check_execinfo_backend(EGGS_STACKTRACE_HAVE_EXECINFO)
    if(EGGS_STACKTRACE_HAVE_EXECINFO)
        include(
            "${CMAKE_CURRENT_LIST_DIR}/eggs.stacktrace-execinfo-targets.cmake"
        )
    else()
        message(
            WARNING
            "eggs.stacktrace: execinfo backend dependencies could not be resolved on this machine; the Execinfo backend will not be available"
        )
    endif()
endif()

# The Libbacktrace backend, when built, is exported as its own targets
# file rather than being bundled into the one above: its dependency is a
# system library resolved on the machine that built this package, which
# may no longer exist (or exist at a different path) on this one - so it
# must be re-resolved here via find_package, same as any other
# find_dependency-style transitive dependency. Isolating it in its own
# file means that, if it can't be found, only this backend goes missing
# instead of failing to include the targets file above.
if(@EGGS_STACKTRACE_HAVE_LIBBACKTRACE@)
    include("${CMAKE_CURRENT_LIST_DIR}/CheckLibbacktraceBackend.cmake")
    eggs_stacktrace_check_libbacktrace_backend(
        EGGS_STACKTRACE_HAVE_LIBBACKTRACE
    )
    if(EGGS_STACKTRACE_HAVE_LIBBACKTRACE)
        include(
            "${CMAKE_CURRENT_LIST_DIR}/eggs.stacktrace-libbacktrace-targets.cmake"
        )
    else()
        message(
            WARNING
            "eggs.stacktrace: libbacktrace could not be found on this machine; the Libbacktrace backend will not be available"
        )
    endif()
endif()

# Create the canonical Eggs::Stacktrace alias for the configured default backend.
if(NOT TARGET Eggs::Stacktrace)
    set(_eggs_stacktrace_default @EGGS_STACKTRACE_DEFAULT_BACKEND_EXPORT@)
    if(
        _eggs_stacktrace_default STREQUAL "Libbacktrace"
        AND NOT TARGET Eggs::Stacktrace::Libbacktrace
    )
        message(WARNING "eggs.stacktrace: falling back to the Null backend")
        set(_eggs_stacktrace_default Null)
    endif()
    if(
        _eggs_stacktrace_default STREQUAL "Execinfo"
        AND NOT TARGET Eggs::Stacktrace::Execinfo
    )
        message(WARNING "eggs.stacktrace: falling back to the Null backend")
        set(_eggs_stacktrace_default Null)
    endif()
    add_library(
        Eggs::Stacktrace
        ALIAS Eggs::Stacktrace::${_eggs_stacktrace_default}
    )
    unset(_eggs_stacktrace_default)
endif()

check_required_components(Eggs.Stacktrace)
