@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/eggs.stacktrace-targets.cmake")

if(@EGGS_STACKTRACE_HAVE_EXECINFO@)
    include("${CMAKE_CURRENT_LIST_DIR}/CheckExecinfoBackend.cmake")
    eggs_stacktrace_check_execinfo_backend(EGGS_STACKTRACE_HAVE_EXECINFO)
    if(EGGS_STACKTRACE_HAVE_EXECINFO)
        include(
            "${CMAKE_CURRENT_LIST_DIR}/eggs.stacktrace-execinfo-targets.cmake"
        )
    else()
        message(
            WARNING
            "eggs.stacktrace: execinfo backend dependencies could not be resolved on this machine; the Execinfo backend will not be available"
        )
    endif()
endif()

if(@EGGS_STACKTRACE_HAVE_LIBBACKTRACE@)
    include("${CMAKE_CURRENT_LIST_DIR}/CheckLibbacktraceBackend.cmake")
    eggs_stacktrace_check_libbacktrace_backend(
        EGGS_STACKTRACE_HAVE_LIBBACKTRACE
    )
    if(EGGS_STACKTRACE_HAVE_LIBBACKTRACE)
        include(
            "${CMAKE_CURRENT_LIST_DIR}/eggs.stacktrace-libbacktrace-targets.cmake"
        )
    else()
        message(
            WARNING
            "eggs.stacktrace: libbacktrace could not be found on this machine; the Libbacktrace backend will not be available"
        )
    endif()
endif()

if(@EGGS_STACKTRACE_HAVE_WIN32@)
    include("${CMAKE_CURRENT_LIST_DIR}/eggs.stacktrace-win32-targets.cmake")
endif()

# Create the canonical Eggs::Stacktrace alias for the configured default backend.
if(NOT TARGET Eggs::Stacktrace)
    set(_eggs_stacktrace_default @EGGS_STACKTRACE_DEFAULT_BACKEND_EXPORT@)
    if(NOT TARGET Eggs::Stacktrace::${_eggs_stacktrace_default})
        message(WARNING "eggs.stacktrace: falling back to the Null backend")
        set(_eggs_stacktrace_default Null)
    endif()
    add_library(
        Eggs::Stacktrace
        ALIAS Eggs::Stacktrace::${_eggs_stacktrace_default}
    )
    unset(_eggs_stacktrace_default)
endif()

check_required_components(Eggs.Stacktrace)
